DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# По умолчанию используется SQLite. Для PostgreSQL раскомментируйте:
# DATABASE_URL=postgresql://hackalem:hackalem@localhost:5432/hackalem

# AI_PROVIDER=mock работает без внешнего API.
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Через запятую, если frontend запускается отдельно.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
